{
  "name": "mihome-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "10.x"
  },
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "test": "vitest run && node --test scripts/environment.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "pnpm run build && playwright test --config playwright.production.config.ts",
    "check": "tsc -b",
    "format": "prettier --write src scripts tests docs AGENTS.md README.md *.json *.ts pnpm-lock.yaml pnpm-workspace.yaml eslint.config.js index.html .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests docs AGENTS.md README.md *.json *.ts pnpm-lock.yaml pnpm-workspace.yaml eslint.config.js index.html .github/workflows/ci.yml",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
